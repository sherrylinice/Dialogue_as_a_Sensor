# Copy this file to `.env` and fill in your API keys.
# Both providers are required by default (OpenAI for Agent 2, Google for the
# simulated user) — the project-overview.md mandates that the question-asking
# VLM and the simulated-user VLM be from different families to avoid bias.

# === API keys ===
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# === Model selection ===
# Agent 2 (Visual Inquisitor / NLG) — generates the clarifying question.
VISUAL_INQUISITOR_PROVIDER=openai
VISUAL_INQUISITOR_MODEL=gpt-5-mini-2025-08-07

# Simulated human-in-the-loop user.
SIMULATED_USER_PROVIDER=google
SIMULATED_USER_MODEL=gemini-3-flash-preview

# Agent 3 (Spatial-to-OSC Grounding / NLU) — converts the human's clarified
# instruction into a JSON of per-waypoint action deltas. Defaults to OpenAI
# because the task is structured-JSON emission rather than dialogue.
SPATIAL_GROUNDING_PROVIDER=openai
SPATIAL_GROUNDING_MODEL=gpt-5-mini-2025-08-07
# Set to false to short-circuit the graph after the dialogue loop (the
# previous behaviour, useful for ablations / debugging Agent 2).
ENABLE_SPATIAL_GROUNDING=true

# === Dialogue settings ===
# Maximum number of clarification rounds before forcing the loop to terminate.
# 1 = single question -> single answer (default per project-overview.md).
MAX_DIALOGUE_TURNS=1

# Optional verbosity (true|false).
DIALOGUE_VERBOSE=true
